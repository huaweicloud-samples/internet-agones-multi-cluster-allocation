# ---------------------------------------------------------------------------
# Cluster orchestration
#
# 编排两组 DGS（Dedicated Game Server）集群 + 一个 router 集群。router 消费各 DGS
# 集群的 allocator 端点 + mTLS 材料，构造 GameServerAllocationPolicy 对象
# （多集群分配）。
#
# 显式 module 调用而非 `for_each`：每个 module 实例从各自集群的证书数据接线
# Kubernetes providers，显式声明能让接线一目了然，避免共享 provider 的历史限制。
# ---------------------------------------------------------------------------

module "dgs01" {
  source = "./modules/cce_cluster"

  cluster_name       = "dgs01"
  cluster_role       = "dgs"
  vpc_id             = huaweicloud_vpc.this.id
  subnet_id          = huaweicloud_vpc_subnet.this["dgs01"].id
  key_pair_name      = var.key_pair_name
  region             = var.huawei_cloud_region
  vpc_cidr           = var.vpc_cidr
  container_network_cidr = "172.18.0.0/16"
  node_flavor_id     = var.node_flavor_id
  gameserver_flavor_id = var.gameserver_flavor_id
  node_os            = var.node_os
  cluster_flavor_id  = var.cluster_flavor_id
  cluster_version    = var.cluster_version
  lts_group_id       = huaweicloud_lts_group.agones.id
  lts_stream_id      = huaweicloud_lts_stream.fluentbit.id
  gameserver_allowed_cidrs     = var.gameserver_allowed_cidrs
  allocator_allowed_cidrs      = var.agones_allocator_allowed_cidrs
  cluster_endpoint_allowed_cidrs = var.cluster_endpoint_allowed_cidrs
  hw_access_key      = var.hw_access_key
  hw_secret_key      = var.hw_secret_key
  hw_project_id      = var.hw_project_id
  swr_addr            = var.swr_addr
  swr_org             = var.swr_org
  allocation_targets = []
}

module "dgs02" {
  source = "./modules/cce_cluster"

  cluster_name       = "dgs02"
  cluster_role       = "dgs"
  vpc_id             = huaweicloud_vpc.this.id
  subnet_id          = huaweicloud_vpc_subnet.this["dgs02"].id
  key_pair_name      = var.key_pair_name
  region             = var.huawei_cloud_region
  vpc_cidr           = var.vpc_cidr
  container_network_cidr = "172.17.0.0/16"
  node_flavor_id     = var.node_flavor_id
  gameserver_flavor_id = var.gameserver_flavor_id
  node_os            = var.node_os
  cluster_flavor_id  = var.cluster_flavor_id
  cluster_version    = var.cluster_version
  lts_group_id       = huaweicloud_lts_group.agones.id
  lts_stream_id      = huaweicloud_lts_stream.fluentbit.id
  gameserver_allowed_cidrs     = var.gameserver_allowed_cidrs
  allocator_allowed_cidrs      = var.agones_allocator_allowed_cidrs
  cluster_endpoint_allowed_cidrs = var.cluster_endpoint_allowed_cidrs
  hw_access_key      = var.hw_access_key
  hw_secret_key      = var.hw_secret_key
  hw_project_id      = var.hw_project_id
  swr_addr            = var.swr_addr
  swr_org             = var.swr_org
  allocation_targets = []
}

module "router" {
  source = "./modules/cce_cluster"

  cluster_name       = "router"
  cluster_role       = "router"
  vpc_id             = huaweicloud_vpc.this.id
  subnet_id          = huaweicloud_vpc_subnet.this["router"].id
  key_pair_name      = var.key_pair_name
  region             = var.huawei_cloud_region
  vpc_cidr           = var.vpc_cidr
  container_network_cidr = "172.16.0.0/16"
  node_flavor_id     = var.node_flavor_id
  gameserver_flavor_id = var.gameserver_flavor_id
  node_os            = var.node_os
  cluster_flavor_id  = var.cluster_flavor_id
  cluster_version    = var.cluster_version
  lts_group_id       = huaweicloud_lts_group.agones.id
  lts_stream_id      = huaweicloud_lts_stream.fluentbit.id
  gameserver_allowed_cidrs     = var.gameserver_allowed_cidrs
  allocator_allowed_cidrs      = var.agones_allocator_allowed_cidrs
  cluster_endpoint_allowed_cidrs = var.cluster_endpoint_allowed_cidrs
  hw_access_key      = var.hw_access_key
  hw_secret_key      = var.hw_secret_key
  hw_project_id      = var.hw_project_id
  swr_addr            = var.swr_addr
  swr_org             = var.swr_org

  # Multi-cluster allocation: hand the router the DGS clusters' allocator
  # endpoints and the mutually-trusted mTLS material generated by cert-manager.
  allocation_targets = [
    for m in [module.dgs01, module.dgs02] : {
      cluster_name         = m.cluster_name
      tls_crt              = m.allocation_service_client_tls_crt
      tls_key              = m.allocation_service_client_tls_key
      ca_crt               = m.allocation_service_server_tls_crt
      endpoint             = m.allocation_service_hostname
      gameserver_namespace = m.gameserver_namespace
    }
  ]
}
